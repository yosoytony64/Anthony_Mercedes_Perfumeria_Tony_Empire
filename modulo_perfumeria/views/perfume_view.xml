<odoo>

  <!--Vista LIST -->
  <record id="view_perfume_list" model="ir.ui.view">
    <field name="name">modulo_perfumeria.perfume.list</field>
    <field name="model">modulo_perfumeria.perfume</field> 
    <field name="arch" type="xml">
      <list string="Lista de los Perfumes">

        <field name="nombrePerfume"/>
        <field name="marcaPerfume"/>
        <field name="precioPerfume"/>
        <field name="observacionesPefume"/>
        <field name="tipoPerfume"/>

      </list>
    </field>
  </record>

  <!-- Vista FORM -->
  <record id="view_perfume_form" model="ir.ui.view">
    <field name="name">modulo_perfumeria.perfume.form</field>
    <field name="model">modulo_perfumeria.perfume</field> 
    <field name="arch" type="xml">
      <form string="Ficha del Perfume">
        <sheet>
          <group>

            <field name="nombrePerfume"/>
            <field name="marcaPerfume"/>
            <field name="precioPerfume"/>
            <field name="observacionesPefume"/>
            <field name="tipoPerfume"/>

          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción que enlaza ambas vistas -->
  <record id="action_perfume" model="ir.actions.act_window">
    <field name="name">PERFUMES</field>
    <field name="res_model">modulo_perfumeria.perfume</field> 
    <field name="view_mode">list,form</field> 
    <field name="view_id" ref="view_perfume_list"/>
  </record>

  <!-- Menús -->
  <menuitem id="menu_perfumes_root" name="Gestionar los perfumes"/>
  <menuitem id="menu_perfumes_modificar"
            parent="menu_perfumes_root"
            name="Perfumes"
            action="action_perfume"/>
</odoo>