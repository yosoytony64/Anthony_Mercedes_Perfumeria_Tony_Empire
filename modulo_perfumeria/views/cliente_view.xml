<odoo>

  <record id="view_cliente_list" model="ir.ui.view">
    <field name="name">modulo_perfumeria.cliente.list</field>
    <field name="model">modulo_perfumeria.cliente</field>
    <field name="arch" type="xml">
      <list string="Lista de Clientes">
        <field name="nombre"/>
        <field name="apellido"/>
        <field name="tipoCliente"/>
        <field name="email"/>
        <field name="esSocio"/>
        <field name="fechaNacimiento"/>
        <field name="fechaAlta"/>
      </list>
    </field>
  </record>

  <record id="view_cliente_form" model="ir.ui.view">
    <field name="name">modulo_perfumeria.cliente.form</field>
    <field name="model">modulo_perfumeria.cliente</field>
    <field name="arch" type="xml">
      <form string="Ficha del Cliente">
        <sheet>
          <field name="foto" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <label for="nombre"/>
            <h1>
              <field name="nombre" placeholder="Nombre..."/>
              <field name="apellido" placeholder="Apellidos..."/>
            </h1>
          </div>
          <group>
            <group string="Datos del Cliente">
              <field name="email"/>
              <field name="tipoCliente"/>
              <field name="esSocio"/>
            </group>
            <group string="Fechas">
              <field name="fechaNacimiento"/>
              <field name="fechaAlta" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Perfumes de Interés">
              <field name="perfume_ids"/>
            </page>
            <page string="Notas y Preferencias">
              <field name="notas"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_cliente_search" model="ir.ui.view">
    <field name="name">modulo_perfumeria.cliente.search</field>
    <field name="model">modulo_perfumeria.cliente</field>
    <field name="arch" type="xml">
      <search string="Buscar Clientes">
        <field name="nombre"/>
        <field name="apellido"/>
        <field name="email"/>
        <separator/>
        <filter string="Socios del Club" name="filter_socio" domain="[('esSocio', '=', True)]"/>
        <filter string="Clientes VIP" name="filter_vip" domain="[('tipoCliente', '=', 'vip')]"/>
        <filter string="Nuevos" name="filter_nuevo" domain="[('tipoCliente', '=', 'nuevo')]"/>
        <separator/>
        <filter string="Tipo de Cliente" name="group_by_tipo" context="{'group_by': 'tipoCliente'}"/>
        <filter string="Es Socio" name="group_by_socio" context="{'group_by': 'esSocio'}"/>
      </search>
    </field>
  </record>

  <record id="action_cliente" model="ir.actions.act_window">
    <field name="name">Clientes</field>
    <field name="res_model">modulo_perfumeria.cliente</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_cliente_search"/>
  </record>

  <menuitem id="menu_clientes_item" parent="menu_perfumes_categoria" name="Clientes" action="action_cliente" sequence="30"/>

</odoo>
